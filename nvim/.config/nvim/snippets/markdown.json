{
	"i": {
		"prefix": ["i", "italic"],
		"body": [
			"*${1:$TM_SELECTED_TEXT}*$0"
		],
		"description": "Italics - Pandoc Markdown"
	},
	"b": {
		"prefix": ["b", "bold"],
		"body": [
			"__${1:$TM_SELECTED_TEXT}__$0"
		],
		"description": "Bold - Pandoc Markdown"
	},
	"bi": {
		"prefix": ["bi", "bold-italic", "italic-bold"],
		"body": [
			"*__${1:$TM_SELECTED_TEXT}__*$0"
		],
		"description": "Bold italics - Pandoc Markdown"
	},
	"strikeout": {
		"prefix": ["k", "strikeout", "struck out"],
		"body": [
			"~~${1:$TM_SELECTED_TEXT}~~$0"
		],
		"description": "Strikeout - Pandoc Markdown"
	},
	"superscript": {
		"prefix": ["super", "superscript", "script-super"],
		"body": [
			"~${1:$TM_SELECTED_TEXT}~$0"
		],
		"description": "Superscript - Pandoc Markdown"
	},
	"subscript": {
		"prefix": ["sub", "subscript", "script-sub"],
		"body": [
			"^${1:$TM_SELECTED_TEXT}^$0"
		],
		"description": "Subscript - Pandoc Markdown"
	},
	"ul": {
		"prefix": ["ul", "underline"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}]{.underline}$0"
		],
		"description": "Underline - Pandoc Markdown"
	},
	"sc": {
		"prefix": ["sc", "smallcaps", "caps-small"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}]{.smallcaps}$0"
		],
		"description": "Small Caps - Pandoc Markdown"
	},
	"hl": {
		"prefix": ["hl", "highlight", "mark"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}]{.mark}$0"
		],
		"description": "Highlight - Pandoc Markdown"
	},
	"h1": {
		"prefix": ["h1"],
		"body": [
			"# ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 1"
	},
	"h2": {
		"prefix": ["h2"],
		"body": [
			"## ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 2"
	},
	"h3": {
		"prefix": ["h3"],
		"body": [
			"### ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 3"
	},
	"h4": {
		"prefix": ["h4"],
		"body": [
			"#### ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 4"
	},
	"h5": {
		"prefix": ["h5"],
		"body": [
			"##### ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 5"
	},
	"h6": {
		"prefix": ["h6"],
		"body": [
			"###### ${1:$TM_SELECTED_TEXT}${3:[${2:unique_id}]}",
			"$0"
		],
		"description": "Heading 6"
	},
	"ref": {
		"prefix": ["ref"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}][${2:SectionId}]$0"
		],
		"description": "Section reference"
	},
	"link": {
		"prefix": ["link"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}](${2:$CLIPBOARD})"
		],
		"description": "Markdown link"
	},
	"link-bare": {
		"prefix": ["link-bare", "link-automatic"],
		"body": [
			"<${1:$CLIPBOARD}>"
		],
		"description": "Automatic/Bare link"
	},
	"linkref": {
		"prefix": ["linkref"],
		"body": [
			"[${1:$TM_SELECTED_TEXT}][${2:id}]$0",
			"",
			"[${2:id}]: ${3:$CLIPBOARD} \"${4:${3}}\""
		],
		"description": "Reference-style link"
    },
	"toc": {
		"prefix": ["toc"],
		"body": [
			"{{TOC:${1:2-3}}}"
		],
		"description": "Insert table of contents"
    },
	"code": {
		"prefix": ["code"],
		"body": [
			"```{$1:language}",
			"${2:$TM_SELECTED_TEXT}",
			"$0",
			"```"
		],
		"description": "Code block"
	},
	"img": {
		"prefix": ["img"],
		"body": [
			"![${1:img alt}](${2:$CLIPBOARD})"
		],
		"description": "Image"
	},
	"footnote": {
		"prefix": ["footnote"],
		"body": [
			"[^${1:footnote-id}]$0",
			"",
			"[^${1}]: ${2:$TM_SELECTED_TEXT}"
		],
		"description": "Footnote"
	},
	"footnote_inline": {
		"prefix": ["footnotei"],
		"body": [
			"[^${1:$TM_SELECTED_TEXT}]$0"
		],
		"description": "Inline footnote"
	},
	"note header": {
		"prefix": ["note-head"],
		"body": [
			"## $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE - ${1:${TM_SELECTED_TEXT}",
			"$0"
		],
		"description": "Note header"
	}
}
